# ==============================================================================
# JobMatch AI - Backend Environment Configuration Example
# Copy this file to `backend/.env` and update the values for your environment.
# ==============================================================================

# Django Core
DEBUG=True
SECRET_KEY=django-insecure-replace-with-a-secure-key-in-production

# MySQL Database Configuration
DB_NAME=jobmatch_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Allowed Hosts & CORS
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Configuration
ACCESS_TOKEN_LIFETIME_DAYS=1
REFRESH_TOKEN_LIFETIME_DAYS=7
